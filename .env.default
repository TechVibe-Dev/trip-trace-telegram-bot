# Copy to .env (or .env.prod, used when APP_ENV=prod) and fill in.
# Variables already set in the environment win over the file.

# --- Telegram ---
# Token from @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids the bot answers to (ask @userinfobot for yours).
# Everyone else is ignored.
ALLOWED_TELEGRAM_USER_IDS=

# --- trip-trace-api ---
API_URL=https://trip-trace-api.onrender.com
# A TripTrace account (email or username) the bot reads data as.
API_USERNAME=
API_PASSWORD=
# Render's free tier can take a while to wake up.
API_TIMEOUT_SECONDS=30

# --- Misc ---
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
